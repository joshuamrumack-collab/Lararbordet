{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Läsa och skriva Lärarbordets datafil, och visa öppna/spara-dialoger",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-mkdir",
    "fs:allow-exists",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$HOME" }, { "path": "$HOME/**" },
        { "path": "$DOCUMENT" }, { "path": "$DOCUMENT/**" },
        { "path": "$APPCONFIG" }, { "path": "$APPCONFIG/**" }
      ]
    }
  ]
}
