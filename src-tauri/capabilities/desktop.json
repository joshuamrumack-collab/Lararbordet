{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Uppdateringar i datorappen: ladda ner och starta installationsfilen",
  "windows": [
    "main"
  ],
  "platforms": [
    "windows",
    "macOS",
    "linux"
  ],
  "permissions": [
    "updater:default",
    "process:allow-restart",
    "process:allow-exit",
    "upload:allow-download",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$DOWNLOAD/**"
        },
        {
          "path": "$TEMP/**"
        }
      ]
    }
  ]
}