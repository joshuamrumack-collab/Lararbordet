{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lärarbordet",
  "mainBinaryName": "lararbordet",
  "version": "1.12.0",
  "identifier": "se.dorkteach.lararbordet",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Lärarbordet",
        "width": 1280,
        "height": 860,
        "minWidth": 380,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "DorkTeach",
    "copyright": "© DorkTeach",
    "category": "Education",
    "shortDescription": "Planering, årshjul, Lgr22-täckning och bedömning för lärare",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "languages": [
          "Swedish",
          "English"
        ],
        "installMode": "currentUser"
      }
    }
  }
}